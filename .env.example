# Local
DATABASE_URL=postgres://crewcode:crewcode@localhost:5432/crewcode
REDIS_URL=redis://localhost:6379
API_PORT=4100
API_BASE=http://localhost:4100

# Sandbox provider
E2B_API_KEY=
SANDBOX_PROVIDER=local-worktree  # | e2b | daytona
TARGET_REPO_URL=

# OpenCode
OPENCODE_PORT=4096
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_PERMISSION=deny:git push,deny:read:.env*

# Vault (doppler://PROJECT/CONFIG/KEY, aws-sm://arn-or-name, env://KEY)
VAULT_PROVIDER=doppler
DOPPLER_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Providers (server-side only, never in prompts)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GITHUB_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Previews: stub | local-docker | railway | fly | vercel | e2b
PREVIEW_PROVIDER=stub
PREVIEW_BASE_URL=http://localhost:3200
RAILWAY_TOKEN=
FLY_API_TOKEN=
VERCEL_TOKEN=

# Notifications
SLACK_WEBHOOK_URL=

# Billing
TOKEN_BUDGET_DEFAULT=200000

# Auth: unset/anything = dev passthrough; false = enforce x-api-key or Bearer
ALLOW_ANON=
CLERK_JWT_VERIFIER=  # set to 'clerk' + CLERK_JWKS_URL for RS256 verify
CLERK_JWKS_URL=      # e.g. https://your-app.clerk.accounts.dev/.well-known/jwks.json
# Self-install (Setup panel downloads portable tools into .crew/bin, no admin)
CLOUDFLARED_BIN=
NODE_PIN_VERSION=v20.19.0

# Sharing (Live Share-style PIN + Cloudflare Quick Tunnel)
CLOUDFLARED_BIN=cloudflared
WEB_PORT=3100
TUNNEL_TARGET=
SHARE_TTL_HOURS=8
SHARE_SALT=change-me-in-prod
GITHUB_WEBHOOK_SECRET=

# Models: the only backend is opencode-go. Pick the model in Settings
# (Your helper's brain) — e.g. opencode-go/mimo-v2.5. No keys here.
